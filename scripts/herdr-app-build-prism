#!/usr/bin/env bash
# Build the Prism bundle the Herdr app's diff views highlight with:
# dot/.config/herdr-app/mods/pi-chat/diff/prism.js, one ES module with Prism's
# core and the languages below (and what they need), from the prismjs npm package.
#
# Usage: scripts/herdr-app-build-prism [version]   (default: the one below)
# Needs node and npm. Re-run after changing LANGUAGES or the version.
set -Eeuo pipefail

VERSION=${1:-1.30.0}
LANGUAGES=(
    # systems, embedded
    c cpp objectivec rust go zig d nim v armasm nasm wasm llvm linker-script glsl hlsl verilog vhdl cmake makefile bison
    # scripting, shells
    python bash shell-session powershell batch lua perl ruby php tcl awk r julia
    # web
    javascript typescript jsx tsx css scss less markup markdown json json5 graphql
    # jvm, .net, mobile
    java kotlin scala groovy csharp fsharp swift dart
    # functional
    haskell ocaml elixir erlang clojure
    # data, config, infra
    yaml toml ini properties editorconfig ignore git diff docker nginx hcl nix sql protobuf csv regex jq
    # docs
    latex qml
)

repo_dir="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
out="$repo_dir/dot/.config/herdr-app/mods/pi-chat/diff/prism.js"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

(cd "$work" && npm pack --silent "prismjs@$VERSION" >/dev/null && tar xzf "prismjs-$VERSION.tgz")

PRISM="$work/package" VERSION="$VERSION" OUT="$out" node - "${LANGUAGES[@]}" <<'NODE'
const fs = require("fs");
const path = require("path");
const dir = process.env.PRISM;
const components = require(path.join(dir, "components.json"));
const getLoader = require(path.join(dir, "dependencies.js"));
const wanted = process.argv.slice(2);
for (const id of wanted) if (!components.languages[id]) throw new Error(`no Prism language "${id}"`);
// Every language a wanted one requires or optionally uses (embedded languages), in load order.
const ids = getLoader(components, wanted).getIds().filter((id) => id !== "core");
const read = (name) => fs.readFileSync(path.join(dir, "components", `prism-${name}.min.js`), "utf8").trim();
const license = fs.readFileSync(path.join(dir, "LICENSE"), "utf8").trim();
const out = [
  `// Prism ${process.env.VERSION} (https://prismjs.com), its core and ${ids.length} languages, as one ES module.`,
  "// Generated by scripts/herdr-app-build-prism: do not edit, re-run it.",
  `// Languages: ${ids.join(" ")}`,
  "/*",
  license,
  "*/",
  "const Prism = (function () {",
  read("core"),
  ...ids.map(read),
  "return Prism;",
  "})();",
  "export default Prism;",
  "",
].join("\n");
fs.writeFileSync(process.env.OUT, out);
console.log(`${process.env.OUT}: ${ids.length} languages, ${Math.round(out.length / 1024)} KB`);
NODE
