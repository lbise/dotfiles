#!/usr/bin/env bash
set -Eeuo pipefail

HOSTS_FILE=${DOTFILES_HOSTS:-$HOME/.config/dotfiles/hosts}
# Hosts file lines are "HOST [# COMMENT]"; lines starting with # are comments.
# Sets host and note to the trimmed parts of the current line.
PARSE_LINE='{
    i = index($0, "#"); host = i ? substr($0, 1, i - 1) : $0; note = i ? substr($0, i + 1) : ""
    gsub(/^[ \t]+|[ \t]+$/, "", host); gsub(/^[ \t]+|[ \t]+$/, "", note)
}'

error() {
    echo "dotfiles-fleet: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: dotfiles-fleet [sync|apps|update|system]
       dotfiles-fleet add HOST [COMMENT] [--label LABEL]
       dotfiles-fleet remove HOST
       dotfiles-fleet list

Runs the selected dotfiles command sequentially on each SSH destination in
$DOTFILES_HOSTS or ~/.config/dotfiles/hosts. Blank lines and comments are
ignored. The default command is update.

add sets up key-based SSH (asking for the password once if needed) and then
lists HOST with COMMENT (adding again replaces the comment). On WSL with the Windows Herdr app (hc.exe), it also adds HOST to
Herdr as N-LABEL, N being the next free ordering number. LABEL defaults to the
remote hostname without the ch03wx prefix. remove unlists HOST. list prints the
listed hosts and their comments.
EOF
}

validate_host() {
    [[ -n "$1" && "$1" != -* && "$1" != *[[:space:]]* && "$1" != *#* ]] ||
        error "invalid SSH destination: $1"
}

# Prints "HOST<TAB>COMMENT" for each listed host.
list_entries() {
    [[ -e "$HOSTS_FILE" ]] || return 0
    [[ -r "$HOSTS_FILE" ]] || error "hosts file is not readable: $HOSTS_FILE"
    awk "$PARSE_LINE"' host != "" { print host "\t" note }' "$HOSTS_FILE"
}

list_hosts() {
    list_entries | cut -f1
}

# Replaces HOST's line with LINE, or deletes it when LINE is empty.
replace_entry() {
    local tmp_file
    tmp_file=$(mktemp "$HOSTS_FILE.XXXXXX")
    awk -v h="$1" -v line="$2" "$PARSE_LINE"' host == h { if (line != "") print line; next } { print }' "$HOSTS_FILE" > "$tmp_file"
    mv "$tmp_file" "$HOSTS_FILE"
}

host_listed() {
    list_hosts | grep -Fxq -- "$1"
}

key_login() {
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$1" true 2>/dev/null
}

# Run a Windows program from a Windows directory; a WSL working directory is a UNC path there.
win() {
    (cd /mnt/c 2>/dev/null || true; "$@")
}

# The Windows Herdr app connects with Windows OpenSSH, which has its own agent and
# known_hosts, so check that login separately before asking Herdr to add the machine.
add_to_herdr() {
    local host=$1 remote_name=$2 label=$3 machines number
    command -v hc.exe >/dev/null || return 0

    # The WSL login just verified this host, so trust its key on first use here.
    if ! win ssh.exe -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$host" true; then
        echo "warning: Windows ssh cannot log in to $host with a key (is the key in the Windows ssh-agent?); not added to Herdr" >&2
        return 0
    fi
    machines=$(win hc.exe machine ls --json | tr -d '\r') || machines=
    if [[ -n "$remote_name" ]] && grep -Fqi "\"host\":\"$remote_name\"" <<<"$machines"; then
        echo "$host is already in Herdr"
        return 0
    fi

    # Herdr sorts machines by name, so an N- prefix sets their order.
    # shortcut: names sort as text, so 10- lands before 2-; pad numbers if you pass nine machines.
    number=$(grep -o '"name":"[0-9]*-' <<<"$machines" | grep -o '[0-9]\+' | sort -n | tail -n 1) || true
    label=${label:-${remote_name#ch03wx}}
    label=${label:-${host#*@}}
    if win hc.exe machine add "$host" --install --name "$((${number:-0} + 1))-$label"; then
        echo "Added $host to Herdr as $((${number:-0} + 1))-$label"
    else
        echo "warning: 'hc.exe machine add $host' failed; add it from Herdr instead" >&2
    fi
}

add_host() {
    local host=$1 comment=$2 label=$3 remote_name entry=$1
    validate_host "$host"
    [[ -z "$label" ]] || validate_host "$label"
    [[ "$comment" != *$'\n'* ]] || error "comment must be a single line"
    [[ -z "$comment" ]] || entry="$host # $comment"

    if ! key_login "$host"; then
        echo "Key login to $host failed; installing your public key (password prompt)."
        ssh-copy-id "$host" || error "ssh-copy-id failed for $host"
        key_login "$host" || error "key login to $host still fails; host not added"
    fi
    echo "Key login to $host works."

    if ! remote_name=$(ssh "$host" 'hostname; test -x ~/.scripts/dotfiles'); then
        echo "warning: ~/.scripts/dotfiles is missing on $host; the fleet pulls an old checkout first, but a machine without the repo needs the installer" >&2
    fi
    remote_name=${remote_name%%.*}

    if ! host_listed "$host"; then
        mkdir -p "$(dirname "$HOSTS_FILE")"
        printf '%s\n' "$entry" >> "$HOSTS_FILE"
        echo "Added $host to $HOSTS_FILE"
    elif [[ -n "$comment" ]]; then
        replace_entry "$host" "$entry"
        echo "Updated the comment of $host in $HOSTS_FILE"
    else
        echo "$host is already listed in $HOSTS_FILE"
        echo "Added $host to $HOSTS_FILE"
    fi

    add_to_herdr "$host" "${remote_name,,}" "$label"
}

remove_host() {
    local host=$1
    validate_host "$host"
    host_listed "$host" || error "$host is not listed in $HOSTS_FILE"

    replace_entry "$host" ""
    echo "Removed $host from $HOSTS_FILE"
}

main() {
    local action=${1:-update}
    local host failed=()

    case "$action" in
        add)
            shift
            local args=() label=""
            while (( $# )); do
                if [[ "$1" == --label ]]; then
                    [[ $# -ge 2 ]] || error "--label requires a LABEL"
                    label=$2
                    shift 2
                else
                    args+=("$1")
                    shift
                fi
            done
            [[ ${#args[@]} -eq 1 || ${#args[@]} -eq 2 ]] || error "usage: dotfiles-fleet add HOST [COMMENT] [--label LABEL]"
            add_host "${args[0]}" "${args[1]:-}" "$label"
            return 0
            ;;
        remove)
            [[ $# -eq 2 ]] || error "remove requires exactly one HOST"
            remove_host "$2"
            return 0
            ;;
    esac
    [[ $# -le 1 ]] || error "only one command may be specified"

    case "$action" in
        list)
            list_entries | awk -F '\t' '{ printf "%-24s %s\n", $1, $2 }'
            return 0
            ;;
        sync|apps|update|system) ;;
        help|--help|-h)
            usage
            return 0
            ;;
        *) error "unsupported remote command: $action" ;;
    esac

    [[ -r "$HOSTS_FILE" ]] || error "hosts file is not readable: $HOSTS_FILE"

    # Read hosts on fd 3: ssh would otherwise consume the rest of stdin.
    while IFS= read -r -u 3 host; do
        [[ "$host" != *[[:space:]]* ]] || error "invalid SSH destination in $HOSTS_FILE: $host"

        echo "===== $host ====="
        local tty_flag=()
        [[ "$action" == system ]] && tty_flag=(-t)
        # A checkout older than the dotfiles command gets a fast-forward pull first;
        # ~/.scripts links to the checkout's scripts directory.
        # One failed host must not stop the others.
        ssh "${tty_flag[@]}" "$host" "{ [ -x ~/.scripts/dotfiles ] || { echo 'Old checkout: pulling first'; git -C ~/.scripts/.. pull --ff-only; }; } && ~/.scripts/dotfiles $action" ||
            failed+=("$host")
    done 3< <(list_hosts)

    [[ ${#failed[@]} -eq 0 ]] || error "failed hosts: ${failed[*]}"
}

main "$@"
