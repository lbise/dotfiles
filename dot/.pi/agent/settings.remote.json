{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "theme": "tokyo-night-custom",
  "extensions": ["~/gitrepo/leo_dotfiles/dot/.pi/agent/extensions"],
