{
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "theme": "tokyo-night-custom",
  "extensions": [
    "~/gitrepo/leo_dotfiles/dot/.pi/agent/extensions"
  ],
  "enabledModels": [
    "github-copilot/gpt-5.6-sol",
    "github-copilot/gpt-5.6-terra"
  ],
  "packages": [
    "npm:pi-subagents",
    "npm:@agnishc/edb-context-viewer",
    "npm:pi-footer"
  ],
  "subagents": {
    "defaultModel": "github-copilot/gpt-5.6-luna",
    "defaultThinking": "low",
    "agentOverrides": {
      "scout": {
        "model": "github-copilot/gpt-5.6-luna",
        "thinking": "low"
      },
      "researcher": {
        "model": "github-copilot/gpt-5.6-luna",
        "thinking": "medium"
      },
      "delegate": {
        "model": "github-copilot/gpt-5.6-luna",
        "thinking": "low"
      },
      "worker": {
        "model": "github-copilot/gpt-5.6-terra",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "github-copilot/gpt-5.6-terra",
        "thinking": "medium"
      },
      "oracle": {
        "model": "github-copilot/gpt-5.6-sol",
        "thinking": "high"
      }
    }
  },
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen"
}