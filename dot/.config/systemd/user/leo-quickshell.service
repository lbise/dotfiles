[Unit]
Description=Leo Quickshell bar
PartOf=graphical-session.target
After=graphical-session.target
# The Bluetooth popup's Pair button needs a pairing agent.
Wants=leo-bt-agent.service

[Service]
Type=exec
ExecStart=/usr/bin/quickshell -n -p %h/.config/quickshell/leo-shell
Restart=always
RestartSec=2
TimeoutStopSec=10
