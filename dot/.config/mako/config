anchor=top-right
default-timeout=5000
max-history=30
width=420
outer-margin=20
padding=10,15

border-size=2
max-icon-size=32

# leo-theme:begin (generated by system-theme-apply.py)
background-color=#1B1D24
text-color=#DCDDE5
border-color=#3B404E
progress-color=over #64D6A5
border-radius=8
font=JetBrainsMono Nerd Font 14

# Criteria sections must follow the global options, so keep this block last.
[urgency=critical]
border-color=#F7768E
# leo-theme:end

# Do not disturb (toggled from the bar). Critical notifications still show.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
