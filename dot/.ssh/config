Include ~/.scripts/ssh_phc_hosts.conf

# herdr-core runs ssh without SSH_AUTH_SOCK, so its BatchMode reconnects can't
# use the agent and hc says "needs login". Fall back to the systemd agent
# (ssh-agent.socket) only when no agent is set and that socket exists.
#Match exec "test -z \"$SSH_AUTH_SOCK\" && test -S \"$XDG_RUNTIME_DIR/ssh-agent.socket\""
#  IdentityAgent ${XDG_RUNTIME_DIR}/ssh-agent.socket

Host *
  AddKeysToAgent yes
  ForwardAgent yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes

Host github.com
  HostName ssh.github.com
  User git
  Port 443

Host vps_moneyz
  HostName 83.228.216.214
  User ubuntu
  IdentityFile ~/.ssh/leo_vps_key

Host srv_leo
  HostName leo-srv.local
  User leo

Host srv_jc
  HostName leo-srv.local
  User jean-claude-bot
  IdentityFile ~/.ssh/id_ed25519
