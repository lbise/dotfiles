#!/bin/sh
# Refresh Herdr's stable agent link for forwarded SSH connections.
# Herdr's remote bridge does not run interactive shell startup, so the shell
# hook cannot update the link in time.
# Only take over a dead link: otherwise any short-lived login (scp, scripts)
# steals the link from the Herdr GUI connection and leaves it dangling on exit.
_herdr_socklink="$HOME/.scripts/herdr-socklink.sh"
if [ -S "${SSH_AUTH_SOCK:-}" ] && [ -O "${SSH_AUTH_SOCK:-}" ] && [ -x "$_herdr_socklink" ] &&
    [ ! -S "$("$_herdr_socklink" show)" ]; then
    "$_herdr_socklink" set-current-socket
fi
