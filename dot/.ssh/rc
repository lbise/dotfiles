#!/bin/sh
# Refresh Herdr's stable agent link for SSH connections.
# Herdr's remote bridge does not run interactive shell startup, so the shell
# hook cannot update the link in time.
# refresh only replaces a dead link: otherwise any short-lived login (scp,
# scripts) steals the link from the Herdr GUI connection and leaves it
# dangling on exit.
if [ -x "$HOME/.scripts/herdr-socklink.sh" ]; then
    "$HOME/.scripts/herdr-socklink.sh" refresh
fi
