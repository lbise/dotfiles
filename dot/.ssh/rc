#!/bin/sh
# Refresh Herdr's stable agent link for every forwarded SSH connection.
# Herdr's remote bridge does not run interactive shell startup, so the shell
# hook cannot update the link in time.
if [ -S "${SSH_AUTH_SOCK:-}" ] && [ -O "${SSH_AUTH_SOCK:-}" ] && [ -x "$HOME/.scripts/herdr-socklink.sh" ]; then
    "$HOME/.scripts/herdr-socklink.sh" set-current-socket
fi
